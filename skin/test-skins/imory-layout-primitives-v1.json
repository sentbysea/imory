{
  "schemaVersion": 1,
  "templates": {
    "home": {
      "html": "<div class=\"lp-shell\" data-imory-layout=\"panel\" data-imory-layout-max-width=\"960\"><header class=\"lp-head\" data-imory-layout=\"stack\" data-imory-layout-direction=\"column\" data-imory-layout-gap=\"6\"><h1 class=\"lp-title\" data-imory-bind=\"site.title\"></h1><p class=\"lp-nick\" data-imory-bind=\"profile.nickname\"></p><p class=\"lp-bio\" data-imory-if=\"profile.bio\" data-imory-bind=\"profile.bio\"></p></header><section class=\"lp-body\" data-imory-layout=\"sidebar\" data-imory-layout-side=\"left\" data-imory-layout-sidebar-width=\"200\" data-imory-layout-gap=\"32\" data-imory-layout-collapse=\"720\"><nav class=\"lp-nav\" data-imory-slot=\"sidebar\" data-imory-layout=\"stack\" data-imory-layout-direction=\"column\" data-imory-layout-gap=\"8\"><a class=\"lp-nav-home\" data-imory-kind=\"navigation.home.iconKind\" data-imory-href=\"navigation.home.href\" data-imory-bind=\"navigation.home.name\"></a><a class=\"lp-nav-link\" data-imory-repeat=\"navigation.categories\" data-imory-kind=\"item.iconKind\" data-imory-href=\"item.href\" data-imory-bind=\"item.name\"></a></nav><div class=\"lp-main\" data-imory-slot=\"main\" data-imory-layout=\"stack\" data-imory-layout-direction=\"column\" data-imory-layout-gap=\"32\"><section class=\"lp-recent\"><h2 class=\"lp-h2\">RECENT</h2><ol class=\"lp-recent-list\" data-imory-layout=\"stack\" data-imory-layout-direction=\"column\" data-imory-layout-gap=\"10\"><li class=\"lp-recent-item\" data-imory-repeat=\"home.recentPosts\" data-imory-layout=\"stack\" data-imory-layout-direction=\"row\" data-imory-layout-gap=\"10\" data-imory-layout-align=\"baseline\"><a class=\"lp-recent-link\" data-imory-href=\"item.href\" data-imory-bind=\"item.title\"></a><time class=\"lp-date\" data-imory-bind=\"item.publishedAtLabel\"></time></li></ol></section><section class=\"lp-banners\" data-imory-if=\"banners.items\"><h2 class=\"lp-h2\">LINKS</h2><div class=\"lp-banner-grid\" data-imory-layout=\"grid\" data-imory-layout-columns=\"3\" data-imory-layout-columns-mobile=\"2\" data-imory-layout-gap=\"12\"><figure class=\"lp-banner\" data-imory-repeat=\"banners.items\"><a data-imory-href=\"item.href\"><img class=\"lp-banner-img\" data-imory-src=\"item.imageUrl\" alt=\"\"></a></figure></div></section><section class=\"lp-hl\" data-imory-if=\"home.highlights.hasCard\"><h2 class=\"lp-h2\" data-imory-bind=\"navigation.highlights.name\"></h2><article class=\"lp-hl-card\" data-imory-repeat=\"home.highlights.featured\" data-imory-color=\"item.color\" data-imory-layout=\"stack\" data-imory-layout-direction=\"column\" data-imory-layout-gap=\"6\"><blockquote class=\"lp-hl-excerpt\" data-imory-bind=\"item.excerpt\"></blockquote><span class=\"lp-hl-source\" data-imory-bind=\"item.sourcePathLabel\"></span></article></section></div></section><section class=\"lp-stage\" data-imory-if=\"home.highlights.hasCard\" data-imory-layout=\"free\" data-imory-layout-height=\"220\" data-imory-layout-max-width=\"640\"><blockquote class=\"lp-stage-quote\" data-imory-repeat=\"home.highlights.featured\" data-imory-color=\"item.color\" data-imory-item-x=\"0\" data-imory-item-y=\"0.5\" data-imory-item-width=\"62\" data-imory-bind=\"item.excerpt\"></blockquote><span class=\"lp-stage-mark\" data-imory-item-x=\"1\" data-imory-item-y=\"0\" data-imory-item-width=\"22\" data-imory-item-z=\"2\" data-imory-bind=\"navigation.highlights.name\"></span></section><footer class=\"lp-foot\"><span data-imory-bind=\"site.slug\"></span></footer></div>"
    },
    "category": {
      "html": "<div class=\"lp-shell\" data-imory-layout=\"panel\" data-imory-layout-max-width=\"960\"><nav class=\"lp-crumb\" data-imory-layout=\"stack\" data-imory-layout-direction=\"row\" data-imory-layout-gap=\"12\"><a class=\"lp-nav-home\" data-imory-href=\"navigation.home.href\" data-imory-bind=\"navigation.home.name\"></a></nav><h1 class=\"lp-title\" data-imory-bind=\"category.name\"></h1><div data-imory-region=\"owner-tools\"></div><div class=\"lp-gallery\" data-imory-if=\"category.isGallery\" data-imory-layout=\"grid\" data-imory-layout-min=\"180\" data-imory-layout-gap=\"12\"><a class=\"lp-card\" data-imory-repeat=\"category.gallery.items\" data-imory-href=\"item.href\"><img class=\"lp-card-img\" data-imory-if=\"item.hasThumbnail\" data-imory-src=\"item.thumbnailUrl\" alt=\"\"><span class=\"lp-card-title\" data-imory-bind=\"item.title\"></span></a></div><ol class=\"lp-list\" data-imory-if=\"category.showPostsList\" data-imory-layout=\"stack\" data-imory-layout-direction=\"column\" data-imory-layout-gap=\"10\"><li class=\"lp-recent-item\" data-imory-repeat=\"category.posts\" data-imory-layout=\"stack\" data-imory-layout-direction=\"row\" data-imory-layout-gap=\"10\" data-imory-layout-align=\"baseline\"><a class=\"lp-recent-link\" data-imory-href=\"item.href\" data-imory-bind=\"item.title\"></a><time class=\"lp-date\" data-imory-bind=\"item.publishedAtLabel\"></time></li></ol><ul class=\"lp-tree\" data-imory-if=\"category.hasFolders\" data-imory-layout=\"stack\" data-imory-layout-direction=\"column\" data-imory-layout-gap=\"6\"><li class=\"lp-tree-node\" data-imory-repeat=\"category.tree\"><a class=\"lp-tree-folder\" data-imory-if=\"item.folderHref\" data-imory-href=\"item.folderHref\" data-imory-bind=\"item.name\"></a><a class=\"lp-recent-link\" data-imory-if=\"item.href\" data-imory-href=\"item.href\" data-imory-bind=\"item.title\"></a></li></ul><nav class=\"lp-pages\" data-imory-if=\"category.pagination.hasPages\" data-imory-layout=\"stack\" data-imory-layout-direction=\"row\" data-imory-layout-gap=\"8\"><a class=\"lp-page-link\" data-imory-repeat=\"category.pagination.pages\" data-imory-href=\"item.href\" data-imory-bind=\"item.label\"></a></nav></div>"
    },
    "post": {
      "html": "<div class=\"lp-shell\" data-imory-layout=\"panel\" data-imory-layout-max-width=\"720\"><nav class=\"lp-crumb\" data-imory-layout=\"stack\" data-imory-layout-direction=\"row\" data-imory-layout-gap=\"12\"><a class=\"lp-nav-home\" data-imory-href=\"navigation.home.href\" data-imory-bind=\"navigation.home.name\"></a><a class=\"lp-back\" data-imory-if=\"post.categoryHref\" data-imory-href=\"post.categoryHref\" data-imory-bind=\"post.categoryName\"></a></nav><header class=\"lp-post-head\" data-imory-layout=\"stack\" data-imory-layout-direction=\"column\" data-imory-layout-gap=\"6\"><h1 class=\"lp-title\" data-imory-bind=\"post.title\"></h1><time class=\"lp-date\" data-imory-bind=\"post.publishedAtLabel\"></time><div data-imory-region=\"owner-tools\"></div></header><div class=\"lp-post-body\" data-imory-region=\"post-body\"></div></div>"
    }
  },
  "css": ".lp-shell{padding:32px 20px;font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:#23201d;line-height:1.75;}.lp-head{border-bottom:1px solid #e7e2dc;padding-bottom:20px;margin-bottom:32px;}.lp-title{font-size:24px;letter-spacing:0.06em;margin:0;}.lp-nick{margin:0;color:#8a827a;font-size:13px;}.lp-bio{margin:0;color:#a89f96;font-size:12px;}.lp-nav-home,.lp-nav-link{font-size:12px;letter-spacing:0.08em;color:#5c544c;text-decoration:none;border-bottom:1px solid transparent;padding-bottom:2px;}.lp-nav-link:hover,.lp-nav-home:hover{border-bottom-color:#c9bfb4;}.lp-nav-link[data-kind='image']{font-style:italic;}.lp-nav-link[data-kind='quote']{color:#b0705f;}.lp-h2{font-size:11px;letter-spacing:0.16em;color:#a89f96;margin:0 0 12px;text-transform:uppercase;}.lp-recent-list,.lp-list,.lp-tree{list-style:none;margin:0;padding:0;}.lp-recent-link{color:#23201d;text-decoration:none;font-size:15px;}.lp-date{color:#b5aca3;font-size:11px;}.lp-banner-img{display:block;width:100%;height:auto;}.lp-banner{margin:0;}.lp-card{display:block;text-decoration:none;color:inherit;}.lp-card-img{display:block;width:100%;aspect-ratio:1/1;object-fit:cover;}.lp-card-title{display:block;font-size:12px;color:#5c544c;padding-top:6px;}.lp-hl-card{border-left:3px solid var(--imory-color,#e0d8cf);padding-left:14px;}.lp-hl-excerpt{margin:0;font-size:14px;}.lp-hl-source{color:#b5aca3;font-size:11px;}.lp-tree-folder{color:#3d3730;text-decoration:none;font-size:14px;}.lp-page-link{color:#8a827a;text-decoration:none;font-size:12px;}.lp-crumb{margin-bottom:24px;}.lp-back{font-size:12px;color:#5c544c;text-decoration:none;}.lp-post-head{margin-bottom:28px;}.lp-foot{margin-top:48px;color:#cfc7be;font-size:11px;letter-spacing:0.1em;}[hidden]{display:none;}.lp-stage{margin-top:40px;}.lp-stage-quote{margin:0;font-size:17px;line-height:1.9;border-left:3px solid var(--imory-color,#e0d8cf);padding-left:16px;}.lp-stage-mark{font-size:10px;letter-spacing:0.2em;color:#b5aca3;text-align:right;}",
  "imageSlots": [],
  "regions": [],
  "metadata": {
    "title": "Imory Layout Primitives v1",
    "description": "배치 primitive 다섯 가지를 한 벌로 보여주는 예시 스킨(IMORY_LAYOUT_PRIMITIVE_DESIGN.md). HOME 은 panel > sidebar > (stack | grid), CATEGORY 는 min 을 준 격자(열 수를 폭이 정한다)와 목록 stack, POST 는 panel + stack 이다. CSS 에는 배치 선언이 한 줄도 없다 — display/grid-template/position 을 쓰지 않고도 같은 레이아웃이 나오는 것이 이 스킨의 요점이고, 그래서 Studio 의 '배치 방식'과 AI 가 같은 속성 하나로 이 레이아웃을 고칠 수 있다.",
    "supports": {
      "home": true,
      "category": true,
      "post": true
    }
  }
}
