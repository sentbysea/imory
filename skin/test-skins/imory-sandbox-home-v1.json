{
  "schemaVersion": 1,
  "renderMode": "sandbox",
  "templates": {
    "home": {
      "html": "<div class=\"sb-page\"><header class=\"sb-head\"><h1 class=\"sb-title\" data-imory-bind=\"site.title\"></h1><p class=\"sb-nick\" data-imory-bind=\"profile.nickname\"></p><p class=\"sb-bio\" data-imory-if=\"profile.bio\" data-imory-bind=\"profile.bio\"></p></header><nav class=\"sb-nav\"><a class=\"sb-nav-home\" data-imory-kind=\"navigation.home.iconKind\" data-imory-href=\"navigation.home.href\" data-imory-bind=\"navigation.home.name\"></a><ul class=\"sb-nav-list\"><li class=\"sb-nav-item\" data-imory-repeat=\"navigation.categories\"><a class=\"sb-nav-link\" data-imory-kind=\"item.iconKind\" data-imory-href=\"item.href\" data-imory-bind=\"item.name\"></a></li></ul></nav><section class=\"sb-banners\" data-imory-if=\"banners.items\"><figure class=\"sb-banner\" data-imory-repeat=\"banners.items\"><img class=\"sb-banner-img\" data-imory-src=\"item.imageUrl\" alt=\"\"></figure></section><section class=\"sb-recent\"><h2 class=\"sb-h2\">RECENT</h2><ol class=\"sb-recent-list\"><li class=\"sb-recent-item\" data-imory-repeat=\"home.recentPosts\"><a class=\"sb-recent-link\" data-imory-href=\"item.href\" data-imory-bind=\"item.title\"></a><span class=\"sb-recent-date\" data-imory-bind=\"item.publishedAtLabel\"></span><span class=\"sb-recent-cat\" data-imory-if=\"item.categoryName\" data-imory-bind=\"item.categoryName\"></span></li></ol></section><section class=\"sb-hl\" data-imory-if=\"home.highlights.hasCard\"><h2 class=\"sb-h2\" data-imory-bind=\"navigation.highlights.name\"></h2><article class=\"sb-hl-card\" data-imory-repeat=\"home.highlights.featured\" data-imory-color=\"item.color\"><blockquote class=\"sb-hl-excerpt\" data-imory-bind=\"item.excerpt\"></blockquote><p class=\"sb-hl-note\" data-imory-if=\"item.hasNote\" data-imory-bind=\"item.note\"></p><span class=\"sb-hl-source\" data-imory-bind=\"item.sourcePathLabel\"></span></article></section><footer class=\"sb-foot\"><span class=\"sb-slug\" data-imory-bind=\"site.slug\"></span></footer></div>"
    },
    "category": {
      "html": "<div class=\"sb-page\"><nav class=\"sb-nav\"><a class=\"sb-nav-home\" data-imory-href=\"navigation.home.href\" data-imory-bind=\"navigation.home.name\"></a></nav><h1 class=\"sb-title\" data-imory-bind=\"category.name\"></h1><ol class=\"sb-recent-list\" data-imory-if=\"category.showPostsList\"><li class=\"sb-recent-item\" data-imory-repeat=\"category.posts\"><a class=\"sb-recent-link\" data-imory-href=\"item.href\" data-imory-bind=\"item.title\"></a><span class=\"sb-recent-date\" data-imory-bind=\"item.publishedAtLabel\"></span></li></ol><ul class=\"sb-tree\" data-imory-if=\"category.hasFolders\"><li class=\"sb-tree-node\" data-imory-repeat=\"category.tree\"><a class=\"sb-tree-folder\" data-imory-if=\"item.folderHref\" data-imory-href=\"item.folderHref\" data-imory-bind=\"item.name\"></a></li></ul><nav class=\"sb-pages\" data-imory-if=\"category.pagination.hasPages\"><a class=\"sb-page-link\" data-imory-repeat=\"category.pagination.pages\" data-imory-href=\"item.href\" data-imory-bind=\"item.label\"></a></nav></div>"
    },
    "post": {
      "html": "<div class=\"sb-page\"><nav class=\"sb-nav\"><a class=\"sb-nav-home\" data-imory-href=\"navigation.home.href\" data-imory-bind=\"navigation.home.name\"></a><a class=\"sb-back\" data-imory-if=\"post.categoryHref\" data-imory-href=\"post.categoryHref\" data-imory-bind=\"post.categoryName\"></a></nav><h1 class=\"sb-title\" data-imory-bind=\"post.title\"></h1><p class=\"sb-recent-date\" data-imory-bind=\"post.publishedAtLabel\"></p><div class=\"sb-body\" data-imory-region=\"post-body\"></div></div>"
    }
  },
  "css": ".sb-page{max-width:720px;margin:0 auto;padding:24px;font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:#222;line-height:1.7;}.sb-head{border-bottom:1px solid #e3e3e3;padding-bottom:16px;margin-bottom:16px;}.sb-title{font-size:22px;letter-spacing:0.08em;margin:0 0 6px;}.sb-nick{margin:0;color:#777;font-size:13px;}.sb-bio{margin:6px 0 0;color:#999;font-size:12px;}.sb-nav{margin-bottom:20px;}.sb-nav-home{display:inline-block;margin-right:12px;font-size:12px;letter-spacing:0.1em;color:#555;text-decoration:none;}.sb-nav-list{list-style:none;display:flex;flex-wrap:wrap;gap:10px;margin:8px 0 0;padding:0;}.sb-nav-link{font-size:12px;color:#555;text-decoration:none;border:1px solid #ddd;border-radius:4px;padding:3px 9px;display:inline-block;}.sb-nav-link[data-kind='gallery']{border-style:dashed;}.sb-nav-link[data-kind='highlight']{border-color:#f3a;}.sb-banners{margin-bottom:20px;}.sb-banner{margin:0 0 8px;}.sb-banner-img{display:block;width:100%;height:auto;}.sb-h2{font-size:12px;letter-spacing:0.14em;color:#999;margin:0 0 8px;}.sb-recent-list{list-style:none;margin:0 0 24px;padding:0;}.sb-recent-item{display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;padding:6px 0;border-bottom:1px dotted #eee;}.sb-recent-link{color:#222;text-decoration:none;font-size:14px;}.sb-recent-date{color:#aaa;font-size:11px;}.sb-recent-cat{color:#bbb;font-size:11px;}.sb-hl{margin-bottom:24px;}.sb-hl-card{border-left:3px solid var(--imory-color,#ddd);padding-left:12px;}.sb-hl-excerpt{margin:0 0 6px;font-size:14px;}.sb-hl-note{margin:0 0 6px;color:#777;font-size:12px;}.sb-hl-source{color:#bbb;font-size:11px;}.sb-foot{color:#ccc;font-size:11px;letter-spacing:0.1em;}.sb-body{margin-top:16px;}@media (max-width:480px){.sb-page{padding:16px;}.sb-title{font-size:18px;}}.sb-tree{list-style:none;margin:0 0 24px;padding:0;}.sb-tree-folder{display:inline-block;padding:4px 0;color:#444;text-decoration:none;font-size:13px;}.sb-pages{display:flex;gap:8px;}.sb-page-link{color:#666;text-decoration:none;font-size:12px;}.sb-back{display:inline-block;margin-left:12px;font-size:12px;color:#555;text-decoration:none;}",
  "imageSlots": [],
  "regions": [],
  "metadata": {
    "title": "Imory Sandbox Pages v1",
    "description": "SANDBOX-1/2 테스트 fixture. renderMode:\"sandbox\" 인 SkinPackage 하나 — HOME/CATEGORY/POST 세 장과 그 사이를 잇는 링크. 디자인이 아니라 \"어떤 공개 데이터가 cross-origin 프레임에 도착했는가\"와 \"프레임 안 링크가 부모 라우터로 이어지는가\"가 화면에 그대로 보이는 것이 목적이다. 저자 JS 없음(js 필드 자체가 없다).",
    "sandbox": {
      "frameContract": 1
    }
  }
}
