  "css": ".mp-page { display: flex; gap: 24px; max-width: 960px; margin: 0 auto; padding: 24px 16px; font-family: system-ui, sans-serif; color: #2c2a2e; }\n.mp-page [hidden] { display: none; }\n.mp-side { flex: 0 0 200px; min-width: 0; }\n.mp-main { flex: 1 1 auto; min-width: 0; }\n.mp-nav, .mp-posts, .mp-folders, .mp-folder-children, .mp-recent { list-style: none; margin: 0; padding: 0; }\n.mp-folder-children { padding-left: 14px; }\n.mp-nav-item { margin: 0 0 6px; }\n.mp-home, .mp-nav-link { position: relative; display: block; padding: 4px 0 4px 24px; color: #2c2a2e; text-decoration: none; }\n.mp-home::before, .mp-nav-link::before { content: \"\"; position: absolute; left: 0; top: 50%; width: 11px; height: 13px; margin-top: -7px; border: 1px solid #8ea7c2; border-radius: 2px; }\n.mp-nav-link[data-kind=\"image\"]::before { width: 15px; height: 11px; margin-top: -6px; }\n.mp-nav-link[data-kind=\"quote\"]::before { width: 13px; height: 9px; margin-top: -5px; border-top: 0; border-right: 0; border-radius: 0 0 0 4px; }\n.mp-nav-link[data-kind=\"link\"]::before { width: 14px; height: 7px; margin-top: -4px; border-radius: 999px; }\n.mp-hl-card { margin: 0 0 16px; padding: 10px 0 10px 14px; border-left: 4px solid var(--imory-color, #d9d6d9); }\n.mp-hl-excerpt, .mp-hl-note { margin: 0 0 6px; overflow-wrap: anywhere; }\n.mp-hl-source, .mp-hl-date { display: block; font-size: 12px; color: #7d7a80; }\n.mp-card { min-width: 0; }\n.mp-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n.mp-pager { display: flex; gap: 10px; margin-top: 16px; }\n@media (max-width: 720px) { .mp-page { display: block; padding: 16px 12px; } .mp-side { margin-bottom: 16px; } .mp-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.mp-home-hl { margin-top: 24px; }\n.mp-home-hl-title { margin: 0 0 10px; font-size: 14px; color: #77737a; }\n.mp-home-hl-card { margin: 0; padding: 10px 0 10px 14px; border-left: 4px solid var(--imory-color, #e4e1e5); }\n.mp-