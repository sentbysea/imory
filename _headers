# =========================================================
# ★ 먼저 알아야 할 것 — 이 파일의 CSS/JS 규칙은 브라우저까지
#   도달하지 않는다 (2026-09-07 imory.me 실측)
#
#   _headers에 있는 HTML  (/index.html)           -> no-cache
#   _headers에 없는 HTML  (/admin/index.html)     -> (헤더 없음)
#   _headers에 있는 CSS   (/posts/posts-base.css) -> max-age=14400
#   _headers에 없는 JS    (/skin/skin-render.js)  -> public, max-age=14400, must-revalidate
#
#   HTML은 이 파일대로 나오고 CSS/JS만 max-age=14400으로 덮인다.
#   캐시 우회 쿼리로 MISS를 강제해도 같다. 즉 이 파일은 정상
#   배포·적용되고 있고, CDN 쪽에서 edge에 캐시되는 응답의
#   Cache-Control만 4시간짜리로 다시 쓴다(Cloudflare Browser
#   Cache TTL / Cache Rules가 하는 일과 같은 모양이지만
#   대시보드를 볼 수 없어 단정하지 않는다 — 확인할 화면은
#   CLAUDE.md 참고).
#
#   그래서 CSS/JS 캐시를 실제로 무효화하는 장치는 URL의
#   ?v=APP_BUILD_VERSION 하나뿐이다(core/lib/build-version.js).
#   아래 CSS/JS 규칙은 지금은 효과가 없지만, CDN 설정이 고쳐지면
#   다시 유효해지므로 의도 표시로 남겨 둔다. **이 파일에 규칙을
#   더 넣는 것으로 캐시 문제를 해결했다고 판단하지 말 것** —
#   HTML이 아니면 실제 응답을 재어 확인해야 한다.
#
#   HTML 진입 문서에는 실제로 먹히므로, 버전 값을 물어오는
#   시작점(아래 문서들)은 계속 여기서 지킨다.
# =========================================================

# build-version.js는 APP_BUILD_VERSION의 유일한 소스다. 위에 적은
# 이유로 이 규칙은 실제 응답에 반영되지 않는다 — 대신 진입 문서들이
# 이 파일만 ?t=<Date.now()>로 불러와서 항상 최신 값을 받는다
# (index.html / auth/index.html / invite/index.html /
# studio/index.html / studio/preview/preview-frame.html).
/core/lib/build-version.js
  Cache-Control: no-cache

# 인증/공개 홈 진입점 HTML도 같은 이유로 재검증을 강제한다 — 새
# 배포 여부를 확인하는 시작점이 이 문서들이기 때문. slug 동적
# 경로(/:slug 등)는 _redirects가 index.html로 rewrite하지만, 이
# 규칙은 원 요청 경로 기준이라 그 경로들까지 자동으로 덮지는
# 않는다 — 그 경로들은 지금까지와 동일하게 동작한다.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/auth/
  Cache-Control: no-cache

/auth/index.html
  Cache-Control: no-cache

# invite/index.html도 build-version.js를 직접 불러오는 진입 문서다
# — 여기가 최신이어야 그 뒤의 ?t=/?v= 사슬이 성립한다.
/invite/
  Cache-Control: no-cache

/invite/index.html
  Cache-Control: no-cache

# Studio chrome(Top Dock 등)은 admin이 iframe으로 계속 재사용하는
# 문서라 탭을 새로고침하지 않는 한 브라우저가 오래 들고 있을 수
# 있다 — 이 세 파일에 명시적 Cache-Control이 없어서 배포 후에도
# 예전 버전이 계속 보이는 문제(Studio chrome 재정리 2라운드에서
# 실사용자가 겪음)가 있었다. 위 규칙들과 동일한 이유로 재검증을
# 강제한다.
/studio/
  Cache-Control: no-cache

/studio/index.html
  Cache-Control: no-cache

# Studio 안의 Preview iframe 문서. 독립된 browsing context라
# 부모의 import map도 캐시 상태도 물려받지 않는다 — 이 문서 자신이
# build-version.js를 ?t= 로 불러오므로 문서만 최신이면 된다.
/studio/preview/preview-frame.html
  Cache-Control: no-cache

/studio/studio.css
  Cache-Control: no-cache

/studio/studio-preview.js
  Cache-Control: no-cache

# 공개 홈이 쓰는 CSS. index.html의 loadVersionedStyles()가
# ?v=APP_BUILD_VERSION을 붙여 주지만, 그 값은 사람이 손으로
# 올려야 하는 문자열이라 배포 때 깜빡 잊을 수 있다. 그때도
# "새 JS + 옛 CSS"(published Skin POST/CATEGORY 프레임이 HOME보다
# 좁고 아래로 밀려 보이던 실사용자 버그의 실제 원인 —
# core/lib/build-version.js 주석 참고)가 재발하지 않도록,
# 위 /index.html·/studio/studio.css와 동일하게 재검증을 강제한다.
# no-cache는 "저장하지 마라"가 아니라 "쓰기 전에 서버에
# 재검증하라"는 뜻이라, 내용이 그대로면 304로 끝난다.
/core/design-tokens.css
  Cache-Control: no-cache

/home/home-base.css
  Cache-Control: no-cache

/home/home-skin-prompt.css
  Cache-Control: no-cache

/home/bgm.css
  Cache-Control: no-cache

/home/menu.css
  Cache-Control: no-cache

/themes/sua/heart-interaction.css
  Cache-Control: no-cache

/themes/sua/cover-profile.css
  Cache-Control: no-cache

/posts/posts-base.css
  Cache-Control: no-cache

/posts/posts-list-detail.css
  Cache-Control: no-cache

/posts/view/posts-view-banner.css
  Cache-Control: no-cache

/posts/posts-editor.css
  Cache-Control: no-cache

/posts/posts-preview-export.css
  Cache-Control: no-cache

/posts/posts-mobile.css
  Cache-Control: no-cache
